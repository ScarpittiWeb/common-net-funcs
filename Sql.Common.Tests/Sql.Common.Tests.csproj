<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<SupportsNetStandardLibs>true</SupportsNetStandardLibs>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<CoverletExclude>[*.Tests]*;[*]System.Text.RegularExpressions.Generated.*</CoverletExclude>
		<CoverletExcludeByFile>**/*.g.cs;**/obj/**;**/bin/**</CoverletExcludeByFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite.Core" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="FakeItEasy" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="NLog.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CommonNetFuncs.Sql.Common\CommonNetFuncs.Sql.Common.csproj" />
		<ProjectReference Include="..\CommonNetFuncs.Sql.SqlServer\CommonNetFuncs.Sql.SqlServer.csproj" />
		<!-- CommonNetFuncs.Sql.PostgreSql only targets net11.0, so it can't be referenced when testing against the netstandard2.1 builds -->
		<ProjectReference Include="..\CommonNetFuncs.Sql.PostgreSql\CommonNetFuncs.Sql.PostgreSql.csproj" Condition="'$(UseNetStandardLibs)' != 'true'" />
	</ItemGroup>

	<!-- The netstandard2.1 build of Sql.SqlServer pins an older Pkcs than the one Microsoft.Data.SqlClient needs on net11.0, so lift it here to avoid a package downgrade error -->
	<ItemGroup Condition="'$(UseNetStandardLibs)' == 'true'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="Shouldly" />
	</ItemGroup>

</Project>
