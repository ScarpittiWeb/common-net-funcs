<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<SupportsNetStandardLibs>true</SupportsNetStandardLibs>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!--
		Build with -p:UseNetStandardLibs=true to run this suite against the netstandard2.1 build of CommonNetFuncs.Core
		(see Directory.Build.targets). Tests that only apply to APIs that exist on the net11.0 (native) build should be
		guarded with `#if CORE_NATIVE_BUILD`.
	-->

	<PropertyGroup>
		<CoverletExclude>[*.Tests]*;[*]System.Text.RegularExpressions.Generated.*</CoverletExclude>
		<CoverletExcludeByFile>**/*.g.cs;**/obj/**;**/bin/**</CoverletExcludeByFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" />
		<PackageReference Include="AutoFixture.AutoFakeItEasy" />
		<PackageReference Include="FakeItEasy" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NLog.Extensions.Logging" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xRetry.v3" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CommonNetFuncs.Core\CommonNetFuncs.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="Shouldly" />
	</ItemGroup>

	<ItemGroup>
		<None Remove=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<None Update="TestData\test.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
