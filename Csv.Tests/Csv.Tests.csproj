<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<SupportsNetStandardLibs>true</SupportsNetStandardLibs>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<CoverletExclude>[*.Tests]*;[*]System.Text.RegularExpressions.Generated.*</CoverletExclude>
		<CoverletExcludeByFile>**/*.g.cs;**/obj/**;**/bin/**</CoverletExcludeByFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" />
		<PackageReference Include="FakeItEasy" />
		<PackageReference Include="coverlet.MTP" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NLog.Extensions.Logging" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="CsvHelper" PrivateAssets="all" />
	</ItemGroup>

	<!--
		CsvHelper's net10.0 asset (picked for this net11.0 project) isn't binary compatible with its netstandard2.1 asset that the netstandard2.1
		build of CommonNetFuncs.Csv is compiled against, so when testing that build use the netstandard2.1 CsvHelper assembly at runtime too.
		Keep the version in sync with Directory.Packages.props.
	-->
	<PropertyGroup>
		<CsvHelperVersion>34.0.0</CsvHelperVersion>
	</PropertyGroup>
	<ItemGroup Condition="'$(UseNetStandardLibs)' == 'true'">
		<PackageReference Update="CsvHelper" ExcludeAssets="compile;runtime" />
		<Reference Include="CsvHelper" HintPath="$(NuGetPackageRoot)csvhelper\$(CsvHelperVersion)\lib\netstandard2.1\CsvHelper.dll" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CommonNetFuncs.Csv\CommonNetFuncs.Csv.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="Shouldly" />
	</ItemGroup>

</Project>
